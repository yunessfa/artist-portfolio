# ==========================================================================
#  Artist Portfolio CMS — environment template
#  cp .env.example .env  و سپس مقادیر را پر کنید. فایل .env هرگز در Git قرار نمی‌گیرد.
# ==========================================================================
COMPOSE_PROJECT_NAME=artistportfolio

# --- Django ---------------------------------------------------------------
# ساخت کلید امن:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO
TIME_ZONE=Asia/Tehran
LANGUAGE_CODE=fa
SITE_URL=http://localhost:8080

# --- CORS / CSRF ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=artistportfolio
POSTGRES_USER=artist
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Paths (inside the container) -----------------------------------------
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
MAX_UPLOAD_SIZE_MB=25

# --- JWT ------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Rate limiting --------------------------------------------------------
THROTTLE_ANON_PER_MINUTE=120
THROTTLE_CONTACT_PER_HOUR=5
THROTTLE_LOGIN_PER_HOUR=20

# --- First admin user (created automatically by entrypoint.sh) ------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong-admin-password
# برای ریست کردن رمز مدیر در اجرای بعدی مقدار را 1 کنید
DJANGO_SUPERUSER_FORCE_RESET=0

# --- Startup behaviour ----------------------------------------------------
DJANGO_COLLECTSTATIC=1
# با ۱ بودن، داده‌های اولیه (قالب‌ها، فصل‌ها، ۶ اثر، رزومه) وارد می‌شود
SEED_ON_START=1

# --- Email (contact form notifications) -----------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@example.com
CONTACT_NOTIFY_EMAIL=

# --- Frontend (Vite build-time) -------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_SITE_URL=http://localhost:8080

# --- Host ports (dev only; production uses a shared reverse proxy) --------
HOST_HTTP_PORT=8080
HOST_HTTPS_PORT=8443

# --- Production only ------------------------------------------------------
ENABLE_HTTPS=1
SECURE_HSTS_SECONDS=31536000
DJANGO_ADMIN_EMAILS=
# نام شبکه‌ی خارجی مشترک داکر برای ریورس‌پروکسی مرکزی VPS
EDGE_NETWORK=edge
PUBLIC_DOMAIN=example.com

# Loopback ports for the multi-project VPS topology (host nginx proxies to these)
FRONTEND_BIND_PORT=8092
BACKEND_BIND_PORT=8011
